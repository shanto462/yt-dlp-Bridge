{
  "manifest_version": 3,
  "name": "yt-dlp Bridge",
  "version": "1.0.0",
  "description": "Download videos, audio and whole playlists with the yt-dlp installed on your Mac. Format, quality, cover art, tags and folder are set here.",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "yt-dlp Bridge",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "contextMenus", "activeTab", "notifications"],
  "host_permissions": ["http://127.0.0.1/*"],
  "commands": {
    "download-current": {
      "suggested_key": { "default": "Alt+Shift+D", "mac": "Alt+Shift+D" },
      "description": "Download the current page with yt-dlp"
    }
  }
}
